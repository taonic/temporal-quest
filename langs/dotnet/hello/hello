#!/bin/sh
# Build the code if it changed, then run it:   ./hello worker   ./hello start SFO JFK   ...
cd "$(dirname "$0")" || exit 1
export DOTNET_NOLOGO=1 DOTNET_CLI_TELEMETRY_OPTOUT=1
# Quiet unless the build fails: then its errors, and nothing runs.
out=$(dotnet build -v q --nologo -nodeReuse:false 2>&1) || { echo "$out"; exit 1; }
exec dotnet bin/Debug/net10.0/Hello.dll "$@"
