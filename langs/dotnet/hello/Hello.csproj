<!-- Fundamentals' hello, in C#: the same workflows, on the same wire contract (hello/CONTRACT.md).

       ./hello worker               the worker (./hello builds it first: dotnet build)
       ./hello start SFO JFK        a trip, and the other commands in Starter.cs -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Hello</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- One copy of the code: no apphost to keep in step. -->
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Temporalio" Version="1.22.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
  </ItemGroup>
</Project>
